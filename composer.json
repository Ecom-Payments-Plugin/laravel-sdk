{
  "name": "ecom-payments/laravel-sdk",
  "description": "Laravel SDK for Ecom Payments",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.1",
    "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
    "illuminate/support": "^10.0|^11.0|^12.0|^13.0"
  },
  "autoload": {
    "psr-4": {
      "Ecom\\Payments\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Ecom\\Payments\\EcomServiceProvider"
      ],
      "aliases": {
        "Ecom": "Ecom\\Payments\\Facades\\Ecom"
      }
    }
  },
  "scripts": {
    "test": "php -d zend.assertions=1 -d assert.exception=1 tests/run.php"
  },
  "archive": {
    "exclude": [
      "/vendor",
      "/composer.lock"
    ]
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
